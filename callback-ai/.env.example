# Public site URL — used to build webhook URLs and Stripe redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Optional: a single Twilio number to use as a fallback "From"
TWILIO_FROM_NUMBER=

# Anthropic (Claude) — primary
ANTHROPIC_API_KEY=
# OpenAI fallback (optional)
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Internal: shared secret protecting webhook signature verification toggles
WEBHOOK_VERIFY_SIGNATURES=true
