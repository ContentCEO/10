{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contractor Flow Launchpad",
  "version": "0.1.0",
  "identifier": "com.contractorflow.launchpad",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Contractor Flow Launchpad",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": true,
        "decorations": true,
        "transparent": false,
        "url": "https://launchpad.contractorflowstore.com/dashboard",
        "userAgent": "ContractorFlowLaunchpad/0.1.0 (Tauri Desktop)"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Contractor Flow",
    "category": "Business",
    "shortDescription": "Website + ads, managed for you — desktop",
    "longDescription": "Contractor Flow Launchpad — we build your website + run your Google + Meta ads + report back monthly. Track your build progress, ad spend, and direct messages from your desktop.",
    "copyright": "© 2026 Contractor Flow",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_ME_GENERATE_VIA_TAURI_SIGNER",
      "endpoints": [
        "https://github.com/ContentCEO/contractor-flow-launchpad/releases/latest/download/latest.json"
      ]
    }
  }
}
