# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider — Anthropic Claude (default) or OpenAI
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to authorize the daily cron endpoint (/api/cron/daily).
# Set this in Vercel and Vercel Cron will send it as Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-string

# Lead intake webhooks (Google Ads, Meta, generic).
# Every ad platform sends this back as either Bearer <secret>, ?secret=, or
# Google's `google_key`. Use a long random string and paste it into the
# matching field on each platform's setup screen.
WEBHOOK_SECRET=replace-with-a-long-random-string

# Meta Lead Ads — required only if connecting Meta directly (not via Zapier).
# META_VERIFY_TOKEN is the value Meta echoes back during webhook handshake.
# META_PAGE_ACCESS_TOKEN is the long-lived token used to fetch lead field data.
# META_APP_SECRET enables HMAC signature verification on incoming webhooks.
META_VERIFY_TOKEN=replace-with-any-string-you-set-on-meta
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=

# Owner gate — only this email sees /owner/* surfaces (Mission Control,
# scraper dashboard, etc). Falls back to a hardcoded email if unset.
OWNER_EMAIL=

# BatchData phone enrichment for scraped permit leads.
# Sign up at dashboard.batchdata.com, generate a key, fund the wallet.
BATCHDATA_API_KEY=

# Generic phone enrichment fallback if you'd rather use Whitepages /
# Endato / PeopleDataLabs / a self-hosted proxy. The endpoint must
# accept JSON { name, address, city, zip } and return { phone }.
PHONE_ENRICH_URL=
PHONE_ENRICH_KEY=

# Lob.com auto-postcard mailing for MA permit leads (Lane B outreach).
# Sign up at dashboard.lob.com; start with test_*, switch to live_*.
LOB_API_KEY=
LOB_FROM_NAME=
LOB_FROM_LINE1=
LOB_FROM_CITY=
LOB_FROM_STATE=
LOB_FROM_ZIP=
LOB_OUTREACH_PHONE=
LOB_OUTREACH_WEBSITE=contractorflowstore.com
# Max postcards per day; defaults to 50 (~$42/day at live prices).
LOB_DAILY_CAP=50
# Optional: full HTML for postcard front/back (4×6 @ 300dpi).
# Variables: {{first_name}} {{address_line1}} {{project_type}} {{business_name}} {{phone}} {{website}}
LOB_POSTCARD_FRONT_HTML=
LOB_POSTCARD_BACK_HTML=

# Tiered Stripe price IDs. STRIPE_PRICE_ID still works as a fallback for the
# Growth tier so existing setups keep functioning.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# Outbound messaging (optional — auto-dispatch falls back to no-op if unset).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Owner cell number for hot-lead SMS alerts (E.164 format, e.g. +15551234567).
OWNER_PHONE=

# Test mode: when set, every outbound SMS/email is logged but not sent.
# Use this to safely exercise crons/flows without burning Twilio credits.
TEST_MODE=

# Vapi voice receptionist webhook authentication. Sign up at dashboard.vapi.ai,
# build an assistant, point its Server URL at /api/voice/vapi-inbound and use
# the same secret here. See /owner/vapi-setup for the full guide.
VAPI_WEBHOOK_SECRET=
VAPI_API_KEY=

# Push notifications (optional — generate keys with `npx web-push generate-vapid-keys`).
# NEXT_PUBLIC_VAPID_KEY must match VAPID_PUBLIC_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# =============================================================================
# Contractor Flow Launchpad (the agency sub-brand — websites + ads for
# contractors). Owner-only ops console lives at /owner/launchpad. Public
# preview sites at preview.contractorflow.com/[slug].
# =============================================================================

# Google Places (New) API key — for discovering local businesses by city +
# trade. If unset, the system falls back to synthetic demo data so the full
# pipeline still runs end-to-end. Get one at console.cloud.google.com (enable
# "Places API (New)").
GOOGLE_PLACES_API_KEY=

# Dedicated preview subdomain. Per Contractor Flow brief Section 6, this
# should be preview.contractorflow.com. With this set, the prospect at slug
# "acme-plumbing-boston" is reachable at:
#   https://preview.contractorflow.com/acme-plumbing-boston
# The middleware rewrites that URL to the internal /preview/sites/{slug}
# route. When unset, previews are reachable directly at
# /preview/sites/[slug] on NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_LAUNCHPAD_PREVIEW_DOMAIN=

# Stripe price IDs for the three Launchpad tiers (Contractor Flow brief
# Section 7). Create these products in Stripe dashboard with the exact
# product IDs below for clean accounting:
#
#   cf_launchpad_foundation                    one-time   $1,997
#   cf_launchpad_foundation_growth_setup       one-time   $997
#   cf_launchpad_foundation_growth_monthly     recurring  $997/mo
#   cf_launchpad_revenue_share_setup           one-time   $497
#   cf_launchpad_revenue_share_monthly         recurring  $497/mo
#   cf_launchpad_revenue_share_8pct            metered    8% of attributed
#                                                         revenue (billed
#                                                         out-of-band via
#                                                         CF CRM attribution)
STRIPE_PRICE_CF_LAUNCHPAD_FOUNDATION=
STRIPE_PRICE_CF_LAUNCHPAD_FOUNDATION_GROWTH_SETUP=
STRIPE_PRICE_CF_LAUNCHPAD_FOUNDATION_GROWTH_MONTHLY=
STRIPE_PRICE_CF_LAUNCHPAD_REVENUE_SHARE_SETUP=
STRIPE_PRICE_CF_LAUNCHPAD_REVENUE_SHARE_MONTHLY=
STRIPE_PRICE_CF_LAUNCHPAD_REVENUE_SHARE_8PCT=
